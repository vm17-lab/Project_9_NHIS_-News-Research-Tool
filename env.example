# Copy this file to .env and fill in your own keys. Never share the real .env file.

# LLM provider: groq (default), gemini or openai
LLM_PROVIDER=groq

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (only if LLM_PROVIDER=gemini)
# GOOGLE_API_KEY=your-google-key
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI (only if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# NewsAPI (free): https://newsapi.org/register
NEWSAPI_KEY=your-newsapi-key

# Optional: only people who know this code can create an account
# SIGNUP_CODE=your-invite-code
